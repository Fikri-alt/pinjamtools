# Template .env untuk InfinityFree - salin jadi .env lalu isi bagian BERTANDA.
APP_NAME="PinjamTools Corpu"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://NAMADOMAINKAMU

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

# Isi dari panel MySQL InfinityFree (jangan pakai kredensial XAMPP!)
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=dbname_xxx
DB_USERNAME=dbname_xxx
DB_PASSWORD=ISI_PASSWORD_DB

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Tanpa symlink (tidak ada SSH): file tersimpan di public/uploads
FILESYSTEM_DISK=public_direct

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@NAMADOMAINKAMU"
MAIL_FROM_NAME="${APP_NAME}"
